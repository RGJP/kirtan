rules_version = '2';
// Règles du vote de date (à coller dans Firebase > Firestore > Règles)
service cloud.firestore {
  match /databases/{database}/documents {
    match /vote-dec2026/{uid} {
      // Tout le monde peut lire (nécessaire pour compter les votes)
      allow read: if true;
      // Chaque visiteur n'écrit que SON document, avec seulement des jours valides
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['days', 't'])
        && request.resource.data.days is list
        && request.resource.data.days.size() <= 15
        && request.resource.data.days.toSet().size() == request.resource.data.days.size()
        && request.resource.data.days.toSet().hasOnly(['2026-12-06', '2026-12-07', '2026-12-08', '2026-12-09', '2026-12-10', '2026-12-11', '2026-12-12', '2026-12-13', '2026-12-14', '2026-12-15', '2026-12-16', '2026-12-17', '2026-12-18', '2026-12-19', '2026-12-20'])
        && request.resource.data.t == request.time;
      allow delete: if false;
    }
  }
}
